# 插件与中继之间的鉴权令牌，必须与 MP 插件「中继令牌」一致
RELAY_TOKEN=change-me

# 夸克 cookie（用于按文件 id 解析直链；只读权限即可）
QUARK_COOKIE=

# 115 cookie（用于创建目录 + 分片上传）
P115_COOKIE=

# 下载腿：内置多连接（0.7.0 起唯一方式，不再需要 Gopeed）
# 单任务的并发 Range 连接数，默认 32；可被 POST /jobs 的 connections 字段覆盖
RELAY_DOWNLOAD_CONNECTIONS=32
# 每个 Range 分片大小（MB），默认 8
RELAY_DOWNLOAD_CHUNK_MB=8

# 数据目录（容器内路径，compose 已挂 ./data）
RELAY_DATA_DIR=/data

# 单文件上限（GB）：35 GB 盘留余量
RELAY_MAX_FILE_GB=25

# 115 分片上传
P115_PART_SIZE_MB=16
P115_UPLOAD_CONCURRENCY=4
P115_INTERNAL_ENDPOINT=oss-cn-shenzhen-internal.aliyuncs.com

# 单个任务最长耗时（秒）
RELAY_JOB_TIMEOUT_SECONDS=10800
