# 插件与中继之间的鉴权令牌，必须与 MP 插件「中继令牌」一致
RELAY_TOKEN=change-me

# 夸克 cookie（用于按文件 id 解析直链；只读权限即可）
QUARK_COOKIE=

# 115 cookie（用于创建目录 + 分片上传）
P115_COOKIE=

# 中继内部 Gopeed 地址（compose 网络内解析）
GOPEED_URL=http://gopeed:9999
GOPEED_TOKEN=
GOPEED_CONNECTIONS=64
# 下载腿：gopeed（夸克扩展解析+多连接）或 builtin（中继自带多连接）
RELAY_DOWNLOAD_ENGINE=gopeed
# 启动时自动安装/更新夸克扩展并把 QUARK_COOKIE 写进扩展设置
QUARK_EXT_AUTO=1

# 数据目录（容器内路径，compose 已挂 ./data）
RELAY_DATA_DIR=/data

# 单文件上限（GB）：35 GB 盘留余量
RELAY_MAX_FILE_GB=25

# 115 分片上传
P115_PART_SIZE_MB=16
P115_UPLOAD_CONCURRENCY=4
P115_INTERNAL_ENDPOINT=oss-cn-shenzhen-internal.aliyuncs.com

# 单个任务最长耗时（秒）
RELAY_JOB_TIMEOUT_SECONDS=10800
